
{
  "name": "ghana-passport-photo-ai",
  "productName": "Passport Studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@imgly/background-removal": "1.7.0",
    "onnxruntime-web": "1.21.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.4.1",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.passportstudio.ghana",
    "productName": "Passport Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
